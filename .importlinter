# Architecture contracts for import-linter (`make imports`; amber-7q0.1). Protected: change
# only through a human-approved pull request. Dependency direction: AGENTS.md.
[importlinter]
root_package = amber
include_external_packages = True

[importlinter:contract:core]
name = The core imports only pydantic, python-ulid, and the standard library
type = forbidden
source_modules =
    amber.schemas
    amber.ids
    amber.grounding
    amber.graph
    amber.graph_errors
    amber._graph_validation
    amber.cases
    amber.tools
forbidden_modules =
    mlflow
    pyarrow
    pytest
    hypothesis
    amber.annotations
    amber.examples
    amber.labels
    amber.interfaces
    amber.policy
    amber.providers
    amber.extraction
    amber.scoring
    amber.span_scoring
    amber.regression
    amber.evaluation
    amber.labeling
    amber.review
    amber.rules
    amber.wire
    amber.bundles
    amber.mlflow_ext
    amber.conformance
    amber.reference
    amber.loupe
broken_contract_guidance = Move the dependency out of the core, or into a plugin that imports the core.

[importlinter:contract:framework]
name = The framework never imports a plugin or an optional stack, even indirectly
type = forbidden
source_modules =
    amber.schemas
    amber.ids
    amber.grounding
    amber.graph
    amber.graph_errors
    amber._graph_validation
    amber.cases
    amber.tools
    amber.annotations
    amber.examples
    amber.labels
    amber.interfaces
    amber.policy
    amber.providers
    amber.extraction
    amber.scoring
    amber.span_scoring
    amber.regression
    amber.evaluation
    amber.labeling
    amber.review
    amber.rules
    amber.wire
    amber.bundles.core
    amber.bundles.schema
forbidden_modules =
    mlflow
    pyarrow
    pytest
    hypothesis
    amber.mlflow_ext
    amber.bundles.parquet
    amber.conformance
    amber.reference
    amber.loupe
broken_contract_guidance = Plugins import the framework, never the reverse; load optional stacks only at a plugin boundary.

[importlinter:contract:unloaded-plugins]
name = import amber and import amber.bundles load no plugin or optional stack
type = forbidden
as_packages = False
source_modules =
    amber
    amber.bundles
forbidden_modules =
    mlflow.**
    pyarrow.**
    pytest
    hypothesis
    amber.mlflow_ext
    amber.mlflow_ext.**
    amber.bundles.parquet
    amber.conformance
    amber.conformance.**
    amber.reference
    amber.reference.**
    amber.loupe
    amber.loupe.**

[importlinter:contract:layers]
name = Plugins over the framework over the core, each layer importing only the layers below it
type = layers
# ADR 0001 (amber-7q0.3). One line per layer, top first: "|" separates modules that may not
# import each other, ":" modules that may. Plugins sit on top (the conformance kit uses the
# reference implementations, and both use Parquet bundles). amber.providers shares a layer with
# amber.interfaces because it names the Provider and PolicyGate protocols for type checking.
# docs/architecture/deps.md draws this graph (scripts/deps_graph.py).
layers =
    amber.conformance
    amber.reference
    amber.mlflow_ext | amber.loupe | amber.bundles.parquet
    amber.bundles.core : amber.span_scoring
    amber.interfaces : amber.providers
    amber.labeling : amber.review
    amber.annotations : amber.extraction : amber.regression : amber.bundles.schema
    amber.examples : amber.labels : amber.policy : amber.scoring : amber.wire : amber.evaluation : amber.rules
    amber.tools
    amber.cases
    amber.graph
    amber._graph_validation
    amber.grounding | amber.graph_errors
    amber.schemas
    amber.ids
broken_contract_guidance = Import downward only (docs/decisions/0001-dependency-layering.md); moving a module to another layer is a human decision.

[importlinter:contract:no-implementations]
name = amber imports no sibling project, model runtime, or provider SDK
type = forbidden
# ADR 0004 (amber-7q0.15): implementations live in lapidary, copal, and loupe.
source_modules =
    amber
forbidden_modules =
    lapidary
    copal
    loupe
    torch
    tensorflow
    jax
    transformers
    sentence_transformers
    huggingface_hub
    mlx
    mlx_lm
    vllm
    llama_cpp
    spacy
    sklearn
    openai
    anthropic
    azure
    pydantic_ai
    litellm
    ollama
broken_contract_guidance = amber owns contracts, not implementations (docs/decisions/0004-contracts-not-implementations.md): move this code to lapidary, copal, or loupe.
